# Website/API server
PORT=3000
PUBLIC_SITE_URL=https://friendlycamp.ir
SESSION_SECRET=replace-with-at-least-32-random-characters

# Comma-separated dashboard origins allowed to call the API directly.
ADMIN_ORIGINS=https://admin.example.com

# One-time administrator bootstrap. Remove the password after first successful start.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-12-plus-character-password-123
ADMIN_BOOTSTRAP_NAME=مدیر سامانه
ADMIN_BOOTSTRAP_PHONE=09000000000

# Leave empty when /api is reverse-proxied on the dashboard domain (recommended).
VITE_ADMIN_API_URL=

# Booking: production defaults to disabled. "sandbox" is an internal test only.
BOOKING_PAYMENT_MODE=disabled
BOOKING_HOLD_SECONDS=900
# Generic HTTPS provider bridge; see BOOKING_VALIDATION.md for the contract.
PAYMENT_HTTP_URL=
PAYMENT_API_TOKEN=
SMS_HTTP_URL=
SMS_API_TOKEN=
# Public browser map tiles; leave empty for OpenStreetMap. Use only a browser-safe URL.
MAP_TILE_URL=
MAP_ATTRIBUTION_TEXT=
MAP_ATTRIBUTION_URL=

# Local SQLite paths. Free Render uses PostgreSQL and does not need a disk.
# Leave APP_DATA_DIR empty for the current local data directory.
APP_DATA_DIR=
PERSISTENT_DISK_MOUNT=
REQUIRE_PERSISTENT_DISK=false
UPLOADS_DIR=
UPLOAD_STORAGE=local
# For Render use UPLOAD_STORAGE=supabase and set these only as server secrets.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role JWT is also supported instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=friendlycamp-uploads

# Free Render deployment: all durable records in Supabase PostgreSQL.
# Keep sqlite for local Docker; on Render set DATABASE_BACKEND=postgres.
DATABASE_BACKEND=sqlite
DATABASE_URL=
# Optional CA certificate for a database whose issuer is not in Node's trust store.
# Certificate verification remains enabled for remote database connections.
DATABASE_SSL_CA=
REQUIRE_EXTERNAL_DATABASE=false
